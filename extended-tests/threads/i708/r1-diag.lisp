;;; r1-diag.lisp -- at the first INVALID-MEMORY-ACCESS in an R1 worker,
;;; print the raw key/value words of every R1 table and the heap areas.
;;; The words are copied out under the GC lock as raw bits, so no bad
;;; pointer is ever held as a Lisp object.
(in-package :cl-user)
(defvar *diag-done* nil)
(defun diag-word () (if (> most-positive-fixnum (expt 2 32)) 8 4))
(defun diag-areas ()
  (let ((sh (if (= (diag-word) 8) 3 2)) (out nil))
    (ccl::do-consing-areas (a)
      (push (list :code (ccl::%fixnum-ref a target::area.code)
                  :low (ash (ccl::%fixnum-ref a target::area.low) sh)
                  :active (ash (ccl::%fixnum-ref a target::area.active) sh)
                  :high (ash (ccl::%fixnum-ref a target::area.high) sh))
            out))
    (nreverse out)))
(defun diag-class (w areas)
  (cond ((zerop (logand w (1- (diag-word)))) :fixnum)
        ((find-if (lambda (a) (and (<= (getf a :low) w) (< w (getf a :active)))) areas) :live)
        ((find-if (lambda (a) (and (<= (getf a :low) w) (< w (getf a :high)))) areas) :past-active)
        (t :outside)))
(defun diag-copy (v)
  ;; Return (values raw-slot-words data-address) for the gvector V.
  (let* ((w (diag-word)) (n (ccl::uvsize v))
         (dest (make-array n :element-type (if (= w 8) '(unsigned-byte 64) '(unsigned-byte 32))))
         (addr 0))
    (ccl::with-macptrs ((p))
      (ccl::without-gcing
        (ccl::%vect-data-to-macptr v p)
        (ccl::%copy-ptr-to-ivector p 0 dest 0 (* n w))
        (setq addr (ccl::%ptr-to-int p))))
    (values dest addr)))
(defun diag-table (h areas)
  (let ((v (ccl::nhash.vector h)))
    (multiple-value-bind (raw addr) (diag-copy v)
      (let ((odd nil) (counts (make-hash-table)) (n 0))
        (loop for i from 14 below (length raw) by 2
              for kw = (aref raw i)
              for cls = (diag-class kw areas)
              do (unless (member cls '(:fixnum :live))
                   (incf (gethash kw counts 0))
                   (incf n)
                   (when (< (length odd) 12)
                     (push (list i kw cls (aref raw (1+ i)) (diag-class (aref raw (1+ i)) areas)) odd))))
        (format t "~&DIAG table ~s weak ~s vec-data #x~x slots ~d flags-word #x~x link-word #x~x non-live-keys ~d~%"
                (hash-table-test h) (ccl:hash-table-weak-p h) addr (length raw) (aref raw 1) (aref raw 0) n)
        (maphash (lambda (kw c) (format t "~&DIAG   key-word #x~x x~d~%" kw c)) counts)
        (dolist (o (nreverse odd))
          (format t "~&DIAG   slot ~d key #x~x ~s value #x~x ~s~%" (first o) (second o) (third o) (fourth o) (fifth o)))))))
(defun diag-on-fault (c h k)
  (unless *diag-done*
    (unless (eq c :selftest) (setq *diag-done* t))
    (let ((areas (diag-areas)))
      (format t "~&DIAG fault ~a in table ~s, new key ~s, gcs ~s~%" c (hash-table-test h) k (ccl:gccounts))
      (format t "~&DIAG markers unbound #x~x slot-unbound #x~x~%"
              (ccl::%address-of (ccl::%unbound-marker)) (ccl::%address-of (ccl::%slot-unbound-marker)))
      (dolist (a areas) (format t "~&DIAG area ~s~%" a))
      (dolist (tb *tables*) (diag-table tb areas))
      (finish-output))))
(setq *on-fault* 'diag-on-fault)
